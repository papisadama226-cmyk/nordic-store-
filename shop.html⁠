<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NORDIC | Boutique Officielle</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header class="navbar">
        <div class="logo">NØRD!C</div>
        <div class="cart-icon-container" onclick="toggleCart()">
            <span>🛒 Panier</span>
            <span id="cartCount">0</span>
        </div>
    </header>

    <section class="shop-hero">
        <h1>COLLECTION STREETWEAR</h1>
        <p>Prix unique par article : <strong>10 000 FCFA</strong></p>
    </section>

    <main class="products-grid">
        
        <div class="product-card">
            <div class="product-tag">10k</div>
            <img src="flower.png" alt="Flower CMYK" class="product-img">
            <h3>T-Shirt Flower CMYK</h3>
            <p>Design Floral Cyan, Jaune, Magenta</p>
            <button class="add-to-cart-btn" onclick="addToCart('T-Shirt Flower CMYK')">Ajouter au Panier</button>
        </div>

        <div class="product-card">
            <div class="product-tag">10k</div>
            <img src="star.png" alt="Nordic Star" class="product-img">
            <h3>T-Shirt Nordic Star</h3>
            <p>Étoile Bleue & Écriture Cursive</p>
            <button class="add-to-cart-btn" onclick="addToCart('T-Shirt Nordic Star')">Ajouter au Panier</button>
        </div>

        <div class="product-card">
            <div class="product-tag">10k</div>
            <img src="godplan.png" alt="God's Plan" class="product-img">
            <h3>T-Shirt God's Plan</h3>
            <p>Lettres Texturées Dollars - Street Concept</p>
            <button class="add-to-cart-btn" onclick="addToCart('T-Shirt God\'s Plan')">Ajouter au Panier</button>
        </div>

        <div class="product-card">
            <div class="product-tag">10k</div>
            <img src="motion.png" alt="Motion Blur" class="product-img">
            <h3>T-Shirt Motion Face</h3>
            <p>Effet Flouté Artistique Noir & Blanc</p>
            <button class="add-to-cart-btn" onclick="addToCart('T-Shirt Motion Face')">Ajouter au Panier</button>
        </div>

        <div class="product-card">
            <div class="product-tag">10k</div>
            <img src="varsity.png" alt="Varsity Block" class="product-img">
            <h3>T-Shirt Varsity Block</h3>
            <p>Style Universitaire Américain Imposant</p>
            <button class="add-to-cart-btn" onclick="addCart('T-Shirt Varsity Block')">Ajouter au Panier</button>
        </div>

        <div class="product-card">
            <div class="product-tag">10k</div>
            <img src="jesus.png" alt="King Jesus" class="product-img">
            <h3>T-Shirt King Jesus</h3>
            <p>Impression Portrait Spray Rouge & Noir</p>
            <button class="add-to-cart-btn" onclick="addToCart('T-Shirt King Jesus')">Ajouter au Panier</button>
        </div>

    </main>

    <div id="cartSidebar" class="cart-sidebar">
        <div class="cart-header">
            <h2>Votre Panier</h2>
            <button class="close-btn" onclick="toggleCart()">✕</button>
        </div>
        <div id="cartItems" class="cart-items-container">
            <p class="empty-msg">Votre panier est vide.</p>
        </div>
        <div class="cart-footer">
            <div class="total-box">
                <span>Total :</span>
                <span id="cartTotal">0 FCFA</span>
            </div>
            
            <div class="form-group-pay">
                <label for="payMethod">Mode de Paiement :</label>
                <select id="payMethod">
                    <option value="Wave 🌊">Wave 🌊</option>
                    <option value="Orange Money 🍊">Orange Money 🍊</option>
                </select>
            </div>

            <div class="form-group-pay">
                <label for="deliveryLocation">Commune / Lieu de livraison :</label>
                <input type="text" id="deliveryLocation" placeholder="Ex: Cocody Angré Terminus 81" required>
            </div>

            <button class="checkout-btn" onclick="validateCheckout()">Confirmer sur WhatsApp</button>
        </div>
    </div>

    <script src="shop.js"></script>
</body>
</html>
