/* Design Global NORDIC */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Helvetica Neue', Arial, sans-serif;
}

body {
    background-color: #050505;
    color: #ffffff;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    padding: 20px;
}

/* Écran de connexion (Index) */
.auth-container {
    background: #111111;
    border: 1px solid #222222;
    padding: 40px 30px;
    border-radius: 12px;
    width: 100%;
    max-width: 420px;
    text-align: center;
}

.brand-badge {
    font-size: 32px;
    font-weight: 900;
    letter-spacing: 6px;
    margin-bottom: 25px;
    color: #fff;
}

h1 {
    font-size: 16px;
    letter-spacing: 2px;
    margin-bottom: 8px;
}

.subtitle {
    font-size: 12px;
    color: #555;
    margin-bottom: 35px;
    text-transform: uppercase;
}

.form-group {
    text-align: left;
    margin-bottom: 22px;
}

.form-group label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #888;
    margin-bottom: 8px;
}

.form-group input, .form-group-pay select, .form-group-pay input {
    width: 100%;
    padding: 14px;
    background: #161616;
    border: 1px solid #282828;
    border-radius: 6px;
    color: #fff;
    font-size: 14px;
    transition: 0.2s;
}

.form-group input:focus {
    border-color: #666;
    outline: none;
}

.neon-btn {
    width: 100%;
    padding: 16px;
    background: #ffffff;
    color: #000000;
    border: none;
    border-radius: 6px;
    font-weight: bold;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    margin-top: 10px;
}

/* Style de la Boutique (Shop) */
.navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background: rgba(5, 5, 5, 0.95);
    border-bottom: 1px solid #151515;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 100;
}

.logo {
    font-size: 22px;
    font-weight: 900;
    letter-spacing: 3px;
}

.cart-icon-container {
    cursor: pointer;
    background: #111;
    padding: 8px 16px;
    border-radius: 20px;
    border: 1px solid #222;
    font-size: 14px;
}

.shop-hero {
    margin-top: 100px;
    text-align: center;
    padding: 40px 20px;
}

.shop-hero h1 {
    font-size: 28px;
    letter-spacing: 4px;
    margin-bottom: 10px;
}

.products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto padding-bottom: 60px;
}

.product-card {
    background: #0d0d0d;
    border: 1px solid #1a1a1a;
    border-radius: 8px;
    padding: 20px;
    text-align: center;
    position: relative;
}

.product-tag {
    position: absolute;
    top: 15px;
    right: 15px;
    background: #fff;
    color: #000;
    padding: 4px 8px;
    font-size: 11px;
    font-weight: bold;
    border-radius: 4px;
}

.product-img {
    width: 100%;
    height: 300px;
    object-fit: contain;
    background: #111;
    margin-bottom: 15px;
    border-radius: 4px;
}

.product-card h3 {
    font-size: 18px;
    margin-bottom: 8px;
}

.product-card p {
    font-size: 13px;
    color: #666;
    margin-bottom: 15px;
}

.add-to-cart-btn {
    width: 100%;
    padding: 12px;
    background: transparent;
    color: #fff;
    border: 1px solid #333;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    transition: 0.2s;
}

.add-to-cart-btn:hover {
    background: #fff;
    color: #000;
}

/* Panier Coulissant */
.cart-sidebar {
    position: fixed;
    top: 0;
    right: -400px;
    width: 100%;
    max-width: 400px;
    height: 100vh;
    background: #0a0a0a;
    border-left: 1px solid #222;
    box-shadow: -10px 0 30px rgba(0,0,0,0.7);
    z-index: 200;
    transition: 0.3s ease;
    display: flex;
    flex-direction: column;
}

.cart-sidebar.active {
    right: 0;
}

.cart-header {
    padding: 20px;
    border-bottom: 1px solid #1a1a1a;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.close-btn {
    background: none;
    border: none;
    color: #fff;
    font-size: 20px;
    cursor: pointer;
}

.cart-items-container {
    flex: 1;
    padding: 20px;
    overflow-y: auto;
}

.cart-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 0;
    border-bottom: 1px solid #151515;
}

.remove-item-btn {
    background: none;
    border: none;
    color: #ff4444;
    cursor: pointer;
}

.cart-footer {
    padding: 20px;
    border-top: 1px solid #1a1a1a;
    background: #0d0d0d;
}

.total-box {
    display: flex;
    justify-content: space-between;
    font-size: 18px;
    font-weight: bold;
    margin-bottom: 20px;
}

.form-group-pay {
    margin-bottom: 15px;
}

.form-group-pay label {
    display: block;
    font-size: 11px;
    color: #aaa;
    margin-bottom: 5px;
}

.checkout-btn {
    width: 100%;
    padding: 15px;
    background: #fff;
    color: #000;
    border: none;
    border-radius: 6px;
    font-weight: bold;
    cursor: pointer;
    text-transform: uppercase;
    font-size: 13px;
}
