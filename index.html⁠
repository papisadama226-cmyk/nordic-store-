<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NORDIC | Accès Privé</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="auth-container">
        <div class="brand-badge">NØRD!C</div>
        <h1>DEMANDE D'ACCÈS PRIVÉ</h1>
        <p class="subtitle">Collection Streetwear 100% Ivoirienne</p>
        
        <form id="authForm">
            <div class="form-group">
                <label for="clientName">Nom complet</label>
                <input type="text" id="clientName" placeholder="Ex: NANGUI ARLETTE" required>
            </div>
            
            <div class="form-group">
                <label for="clientPhone">Numéro de téléphone</label>
                <input type="tel" id="clientPhone" placeholder="Ex: 0702797128" required>
            </div>
            
            <div class="form-group">
                <label for="accessCode">Code d'accès secret</label>
                <input type="password" id="accessCode" placeholder="Optionnel (si vous l'avez déjà)">
            </div>
            
            <button type="submit" class="neon-btn">Demander l'accès au catalogue</button>
        </form>
    </div>

    <script src="auth.js"></script>
</body>
</html>
